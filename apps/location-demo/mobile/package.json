    "build:ios:dev": "eas build --profile development --platform ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "~53.0.0",
    "expo-battery": "~9.1.4",
    "expo-location": "~18.1.6",
    "expo-status-bar": "~2.2.3",
    "expo-task-manager": "~13.1.6",
    "react": "19.0.0",
    "react-native": "0.79.5"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  }
}
