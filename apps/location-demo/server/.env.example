# 位置情報デモサーバーの設定。`cp .env.example .env` して値を入れる。
# トークンは `node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"` で生成できる。

PORT=8787
HOST=0.0.0.0

# 端末(スマホ)に配るトークン。位置の投稿と自分のデータ削除だけができる。
INGEST_TOKEN=CHANGE_ME_ingest

# 管理ダッシュボード用トークン。全端末の位置が見える。絶対に端末に入れないこと。
ADMIN_TOKEN=CHANGE_ME_admin

# 保存期間(時間)。これより古い位置は 10 分おきに自動削除される。
RETENTION_HOURS=72

DB_PATH=./data/locations.db
